{
  "name": "bdo-organizer",
  "version": "1.0.0",
  "private": true,
  "description": "Blood Donation Drive Organizer - three integrated services, Floci/AWS + Cloudflare/Neon deployments",
  "workspaces": [
    "shared",
    "services/drive",
    "services/donor",
    "services/booking",
    "frontend"
  ],
  "scripts": {
    "dev": "node infra/scripts/dev-all.js",
    "test": "node --test --test-concurrency=1",
    "seed": "node infra/scripts/seed.js",
    "zip:all": "node infra/scripts/zip-lambda.js",
    "workers:bundle": "node infra/scripts/bundle-workers.js",
    "deploy:floci": "bash infra/deploy-all.sh",
    "deploy:cloudflare": "node infra/scripts/configure-cloudflare.js",
    "evidence:capture": "node infra/scripts/capture-evidence.js"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
