# Copy to .env for local development. Never commit the populated .env file.
NODE_ENV=development
TEST_MODE=1
EMAIL_MODE=log
DATA_DRIVER=sqlite
SQLITE_PATH=.data/bdo.sqlite
JWT_SECRET=replace-with-a-long-random-string
INTERNAL_KEY=replace-with-another-random-string
ORGANIZER_INVITE=blood2026
DRIVE_SERVICE_URL=http://localhost:3001
DONOR_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
CORS_ORIGINS=http://localhost:8090

# Optional real integrations (leave empty locally)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
BREVO_API_KEY=
EMAIL_FROM=Blood Drive <donations@example.org>

# Cloudflare / Neon deployment (used by npm run deploy:cloudflare)
DATABASE_URL=
FRONTEND_URL=
DRIVE_WORKER_URL=
DONOR_WORKER_URL=
BOOKING_WORKER_URL=
