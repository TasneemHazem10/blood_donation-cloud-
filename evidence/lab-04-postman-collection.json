{
  "info": {
    "_postman_id": "bdo-lab-04-collection",
    "name": "Blood Donation Drive Organizer API",
    "description": "Lab 4 style Postman Desktop collection for the three BDO Express APIs. Set baseUrl to a local service (http://localhost:3001, 3002 or 3003) or to the Floci API Gateway URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "organizerToken", "value": "" }
  ],
  "item": [
    {
      "name": "T01 Drive health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/health/drive", "host": ["{{baseUrl}}"], "path": ["api", "health", "drive"] }
      }
    },
    {
      "name": "T02 View drives",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/drives", "host": ["{{baseUrl}}"], "path": ["api", "drives"] }
      }
    },
    {
      "name": "T03 Invalid create drive (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
        "body": { "mode": "raw", "raw": "{\"title\":\"\",\"date\":\"not-a-date\"}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/drives", "host": ["{{baseUrl}}"], "path": ["api", "drives"] }
      }
    },
    {
      "name": "T04 Unknown route (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/does-not-exist", "host": ["{{baseUrl}}"], "path": ["api", "does-not-exist"] }
      }
    },
    {
      "name": "T05 CORS preflight from local website",
      "request": {
        "method": "OPTIONS",
        "header": [{ "key": "Origin", "value": "http://localhost:8090" }, { "key": "Access-Control-Request-Method", "value": "GET" }],
        "url": { "raw": "{{baseUrl}}/api/drives", "host": ["{{baseUrl}}"], "path": ["api", "drives"] }
      }
    },
    {
      "name": "T06 Malformed JSON (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/drives", "host": ["{{baseUrl}}"], "path": ["api", "drives"] }
      }
    },
    {
      "name": "T07 Donor register validation (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"not-an-email\",\"password\":\"short\"}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "http://localhost:3002/api/auth/register", "host": ["http://localhost:3002"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "T08 Bookings require auth (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:3003/api/bookings/mine", "host": ["http://localhost:3003"], "path": ["api", "bookings", "mine"] }
      }
    }
  ]
}
